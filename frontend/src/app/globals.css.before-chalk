:root {
  color-scheme: dark;
  --color-bg: #080d18;
  --color-surface: #101827;
  --color-surface-raised: #172235;
  --color-border: #253247;
  --color-text: #f1f5f9;
  --color-muted: #94a3b8;
  --color-primary: #36d6bd;
  --color-primary-hover: #21bba4;
  --color-danger: #fb7185;
  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 24px;
  --shadow-card: 0 16px 48px rgb(0 0 0 / 18%);
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  margin: 0;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: Tahoma, Arial, sans-serif;
  font-size: 14px;
  line-height: 1.8;
  direction: rtl;
  -webkit-font-smoothing: antialiased;
}

button,
input,
textarea,
select {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  color: inherit;
}

a {
  color: inherit;
  text-decoration: none;
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 3px;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

::selection {
  background: rgb(54 214 189 / 25%);
  color: white;
}

img,
svg {
  display: block;
  max-width: 100%;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}
